--- !u!114 &2013022677
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2013022675}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 28
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<size=40><b>VR INPUT DEMO</b></size>   <color=#9AB>Meta Quest 3S  \u2022 
    OVRInput / OVRHand / Interaction SDK</color>\n\n<b><color=#FFD27F>KONTROLERY</color></b>\nTrigger
    \u2013 wyb\xF3r promieniem (cele, przyciski, przyci\u0105ganie obiekt\xF3w)\nGrip
    \u2013 chwy\u0107 obiekt w zasi\u0119gu r\u0119ki; pu\u015B\u0107 w ruchu = rzut\nA
    \u2013 strza\u0142 pociskiem     B \u2013 losowe kolory obiekt\xF3w\nX \u2013
    nowa kula przy lewej r\u0119ce     Y \u2013 test wibracji (haptyka)\nMenu \u2013
    reset sceny     klik lewej ga\u0142ki \u2013 poka\u017C/ukryj panele\nLewa ga\u0142ka
    \u2013 chodzenie     prawa ga\u0142ka \u2013 obr\xF3t o 45\xB0     klik prawej
    \u2013 powr\xF3t na start\n\n<b><color=#9FE8A0>D\u0141ONIE</color></b>  (od\u0142\xF3\u017C
    kontrolery i poka\u017C d\u0142onie)\nPinch (kciuk + wskazuj\u0105cy) \u2013
    chwyt z bliska albo wyb\xF3r promieniem z d\u0142oni\nPi\u0119\u015B\u0107 \u2013
    chwyt obiektu     wyprostowany palec wskazuj\u0105cy \u2013 wciskanie przycisk\xF3w\nZnak
    V \u2013 nowa kula nad d\u0142oni\u0105\nKciuk w g\xF3r\u0119 (1 s) \u2013 reset
    sceny     kciuk w d\xF3\u0142 (1 s) \u2013 poka\u017C/ukryj panele\nMikrogesty
    kciukiem po palcu wskazuj\u0105cym: lewo/prawo \u2013 obr\xF3t,\n    prz\xF3d/ty\u0142
    \u2013 krok, stukni\u0119cie \u2013 strza\u0142\n\n<color=#C8A0FF>Za Tob\u0105:
    strefa Interaction SDK (obiekty z Building Blocks ISDK).</color>"
